//----підключає стандартну бібліотеку----
#include <stdlib.h>
#include <stdio.h>
//----підключає математичну бібліотеку----
#include <math.h>

int main()
{
    //----оголошує дві змінні з плаваючою комою подвійної точності----
    double x, y;
    
    printf("Enter x:");
    //----зчитує введене користувачем число з консолі----
    scanf("%lf", &x);
    
    //----перевіряє першу умову інтервалу----
    if(x >= -5 && x < 0)
        y = pow(x, 2) + 2*x + 1;
    else if (x >= 0 && x < 10)
    //---- реалізує другу математичну формулу для інтервалу----
        y = sqrt(x + 1) - 1.0 / sqrt(x + 5);
    else if (x >= 10 && x < 1000)
    //----реалізує третю формулу для інтервалу----
        y = log10(x) + 2*x;
    else
        y = x / 2.0;
        
    //----очищує екран----
    system("cls");
    //----виводить на екран початкове значення x, яке ввів користувач.----
    printf("x = %lf", x);
    //----виводить на екран порахований результат ----
    printf("\ny = %lf", y);
    return 0;
}
